Keep vision towers with head_dim % 32 != 0 (Qwen2.5-VL ViT = 80) off vLLM's
bundled FA2 kernel. Not needed on Blackwell (sm_100+ already forces SDPA).

--- a/vllm/model_executor/models/vision.py
+++ b/vllm/model_executor/models/vision.py
@@ -98,6 +98,18 @@
     if selected_backend is not None:
         return selected_backend
 
+    # PATCH: on A100 (sm_80) the platform picks FLASH_ATTN for
+    # ViT head sizes that FlashAttentionBackend.supports_head_size() claims to support,
+    # but vLLM's bundled FA2 varlen kernel rejects any head_dim not a multiple of 32
+    # (Qwen2.5-VL ViT head_dim=80 -> runtime "headdim not a multiple of 32" crash).
+    # Blackwell already forces TORCH_SDPA for all ViTs (see cuda.py); mirror that here for
+    # non-mult-of-32 head sizes on pre-Blackwell GPUs. head_size%32==0 ViTs
+    # (InternVL=128) keep the normal FA path; eval passes TORCH_SDPA via
+    # attn_backend_override and returns early above, so it is unaffected.
+    if head_size % 32 != 0:
+        from vllm.attention.backends.registry import AttentionBackendEnum
+        return AttentionBackendEnum.TORCH_SDPA
+
     return current_platform.get_vit_attn_backend(head_size, dtype)
 
 
